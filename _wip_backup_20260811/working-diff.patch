+// isRateLimitText reports whether an upstream answer is in fact a throttling
+// notice delivered as ordinary bot text rather than an error frame. ChatHub
+// returns such notices through the normal text path, so error inspection alone
+// would miss them and the account would keep rotating into the same wall.
+func isRateLimitText(text string) bool {
+	t := strings.ToLower(text)
+	if strings.Contains(t, "too many requests") ||
+		strings.Contains(t, "rate limit") ||
+		strings.Contains(t, "throttl") ||
+		strings.Contains(t, "try again later") {
+		return true
+	}
+	return strings.Contains(t, "鏃犳硶鍝嶅簲杩欎箞澶氳姹?) ||
+		strings.Contains(t, "璇风◢鍚庨噸璇?)
+}
+
+// verifyThrottledAnswer re-asks a minimal probe on the same account when an
+// answer looks like a rate-limit notice, so a legitimate reply that merely
+// mentions the phrase is not misclassified as throttling.
+func (s *Server) verifyThrottledAnswer(ctx context.Context, acc auth.AccountToken, text string) error {
+	if !isRateLimitText(text) {
+		return nil
+	}
+	probeCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	probe, err := s.chat.Chat(probeCtx, chathub.Account{AccessToken: acc.AccessToken, OID: acc.OID, TID: acc.TID}, chathub.Request{Text: "hi"})
+	if err != nil || isRateLimitText(probe.Text) {
+		return &UpstreamHTTPError{Status: 429, Body: text}
+	}
+	return nil
+}
+
 // accountHealth tracks per-account failure state: rate-limited accounts are
 // cooled down and skipped by the round-robin until the window expires, and
 // auth-failed accounts are pinned as unusable.
