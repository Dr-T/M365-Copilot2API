+// unseenSuffix returns the portion of snapshot not already present in cur.
+// ChatHub texts arrive on two channels: writeAtCursor deltas (independent
+// 3-6 byte increments, never overlapping cur) and messages snapshots (full
+// paragraphs that re-deliver content). Snapshot overlap must be trimmed at
+// UTF-8 rune boundaries; trimming inside a multi-byte character corrupts the
+// output. Formatting-only differences (\r\n vs \n, zero-width chars) are
+// collapsed before comparison via normalizeText.
+func unseenSuffix(snapshot, cur string) string {
+	if snapshot == "" {
+		return ""
+	}
+	if cur == "" {
+		return snapshot
+	}
+	if d, ok := unseenAfter(snapshot, cur); ok {
+		return d
+	}
+	// Retry against a formatting-normalized view. A hit means the snapshot
+	// differs from the stream only cosmetically; nothing new to emit, the
+	// cursor deltas already carried the real content.
+	if _, ok := unseenAfter(normalizeText(snapshot), normalizeText(cur)); ok {
+		if strings.HasPrefix(snapshot, cur) {
+			return strings.TrimPrefix(snapshot, cur)
+		}
+		return ""
+	}
+	// Both sides diverge without containment or suffix overlap: mid-stream
+	// rewrite or a fresh paragraph. Emit from the first common-prefix offset
+	// that lands on a rune boundary so multi-byte characters stay intact.
+	i := commonPrefixCell(snapshot, cur)
+	return snapshot[i:]
+}
+
+// commonPrefixCell returns the byte offset after the longest common prefix of
+// a and b, aligned to a UTF-8 rune boundary of a.
+func commonPrefixCell(a, b string) int {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	for i > 0 && i < len(a) && (a[i]&0xC0) == 0x80 {
+		i--
+	}
+	return i
+}
+
+// unseenAfter reports whether cur and snapshot overlap in one of the four
+// stream-relevant shapes (prefix, containment, suffix).
+func unseenAfter(snapshot, cur string) (string, bool) {
+	if strings.HasPrefix(snapshot, cur) {
+		return strings.TrimPrefix(snapshot, cur), true
+	}
+	if strings.Contains(cur, snapshot) {
+		return "", true
+	}
+	if i := strings.Index(snapshot, cur); i >= 0 && i+len(cur) < len(snapshot) {
+		return snapshot[i+len(cur):], true
+	}
+	if strings.HasSuffix(snapshot, cur) {
+		return snapshot[:len(snapshot)-len(cur)], true
+	}
+	return "", false
+}
+
+// normalizeText collapses formatting deltas between the cursor stream and the
+// messages channel (\r\n vs \n, zero-width characters) so text that differs
+// only cosmetically matches as already-seen.
+func normalizeText(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\r", "\n")
+	s = strings.ReplaceAll(s, "\u200b", "")
+	s = strings.ReplaceAll(s, "\ufeff", "")
+	return s
+}
